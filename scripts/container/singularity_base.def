Bootstrap: docker
From: nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%labels
    Maintainer Artur Gasparyan
    Description Python 3.12 base image with curl, git, build tools, and uv

%environment
    export UV_PROJECT_ENVIRONMENT=/usr/local

%post
    set -e  # fail fast on any command error
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && \
        apt-get install -y \
            curl \
            git \
            build-essential \
            software-properties-common && \
        apt-get update &&
        add-apt-repository -y ppa:deadsnakes/ppa && \
        apt-get install -y python3.12 python3.12-venv python3.12-dev python3-pip git && \
        update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 && \
        update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
        pip install --upgrade pip && \
        apt-get update && \
        apt-get clean && \
        apt-get autoremove && \
        rm -rf /var/lib/apt/lists/*


    curl -LsSf https://astral.sh/uv/install.sh | sh && mv ~/.local/bin/uv /usr/local/bin/uv && chmod +x /usr/local/bin/uv
    
    uv pip install torch torchvision triton lightning --system